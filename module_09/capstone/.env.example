# Copy to .env and change what you need:
#   cp .env.example .env
# docker-compose passes it to the backend. It's ignored by git and kept out
# of both images. A missing or blank line uses the default shown.

# ── backend (read by backend/config.py) ──────────────────────────────────

# signs the login tokens, at least 32 bytes (48 for HS384, 64 for HS512).
# Blank means a random one each time the API starts, which logs everyone out
# on restart. Generate one with
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=

# HS256, HS384 or HS512. Nothing else is accepted
JWT_ALGORITHM=HS256

# minutes a login lasts
JWT_EXPIRE_MINUTES=30

# model for /ask, also what ollama-pull downloads (~2GB). llama3.2:1b is a
# 1.3GB download and about twice as fast, but on the check-in questions it
# made things up and got 3 of 9 fully right against 3b's 6 (CHECK_IN.md)
MODEL_NAME=llama3.2:3b

# vector matches further than this from the question are left out of the
# prompt (squared L2, 0 to 4). Doesn't apply when the question names a company
# or you pick postings, and chunks found by the keyword pass (a word from the
# question in the posting text) are kept however far they are. If nothing at
# all is within it, the question counts as off topic and the model isn't asked
MAX_DISTANCE=1.45

# seconds to wait for Ollama before /ask gives up with a 503. Compose passes
# it to the frontend too, which waits 30s longer for the answer
OLLAMA_TIMEOUT=120

# true/false, logs retrieval distances and Ollama timings
DEBUG=false

# ── outside Docker only (compose sets its own values) ────────────────────

# DATABASE_URL=sqlite:///./jobfit.db
# CHROMA_PATH=./chroma
# OLLAMA_URL=http://localhost:11434

# ── compose ──────────────────────────────────────────────────────────────

# the database user and name. There's no password to set: the first start
# generates one into the db_secret volume, and nothing outside the compose
# network can reach Postgres
POSTGRES_USER=jobfit
POSTGRES_DB=jobfit

# host port for the ollama container, not 11434 so it can't clash with a host Ollama
OLLAMA_HOST_PORT=11435

# ── frontend (only when running app.py outside Docker) ───────────────────

# compose sets http://backend:8000 for the container
BACKEND_URL=http://localhost:8000
