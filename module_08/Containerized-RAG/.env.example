# Copy to .env and change what you need:
#   cp .env.example .env
# docker-compose passes .env to the backend container. It's ignored by git
# and kept out of both images. A missing or blank line uses the default shown.

# ── backend (read by backend/config.py) ──────────────────────────────────

# Ollama server. docker-compose.yml always sets http://ollama:11434 for the
# container, this value only matters when running uvicorn outside Docker
OLLAMA_URL=http://localhost:11434

# model /ask uses, has to be pulled first:
#   docker-compose exec ollama ollama pull llama3.2:1b
MODEL_NAME=llama3.2:1b

# ChromaDB folder. Relative paths are taken from backend/. Compose sets
# /app/rag_db, where the chroma_data volume is mounted
CHROMA_PATH=./rag_db

# default n_results for /ask, 1 to 20
MAX_RESULTS=3

# confidence is high below 0.5, medium up to this, low above it.
# Squared L2 distance, 0 (identical) to 4
CONFIDENCE_THRESHOLD=1.0

# default max_distance for /ask, chunks further than this are dropped.
# Between CONFIDENCE_THRESHOLD and this the chunk is used but flagged low
MAX_DISTANCE=1.2

# true/false, logs retrieval distances and Ollama timings
DEBUG=false

# ── compose ──────────────────────────────────────────────────────────────

# host port for the ollama container. 11435 if Ollama already runs on the host
OLLAMA_HOST_PORT=11434

# ── frontend (only when running app.py outside Docker) ───────────────────

# compose sets http://backend:8000 for the container
BACKEND_URL=http://localhost:8000
