# Every variable backend/config.py reads, with the value the CI test job runs
# with. Copy to .env to use them locally. .env is git-ignored and kept out of
# both images, so CI never sees one.
#
# Order of precedence: a variable already set in the shell (or in a step's env:
# in ci.yml) > .env > the default in config.py. A blank value counts as unset.

# ── set by the test job (env: on the "Run tests" step) ───────────────────

# Nothing listens on this in CI. tests/test_api.py fakes every call to Ollama,
# the URL only has to start with http:// or https:// for config.py to load.
# Running uvicorn locally, this is where /ask and /health reach Ollama
OLLAMA_URL=http://localhost:11434

# ChromaDB folder, relative to backend/. The tests use ./test_chroma so a test
# run never touches ./rag_db, the folder uvicorn uses by default. Change it to
# ./rag_db if you copy this file to run the API itself
CHROMA_PATH=./test_chroma

# ── not set in CI, tests/test_api.py pins them to these defaults ────────
# a local .env can't change what the tests see, so these only affect uvicorn

# model /ask sends prompts to, has to be pulled first: ollama pull llama3.2:1b
MODEL_NAME=llama3.2:1b

# default n_results for /ask, whole number from 1 to 20
MAX_RESULTS=3

# default max_distance for /ask, 0 to 4. Chunks further away are dropped
CONFIDENCE_THRESHOLD=1.0

# true/false. Logs retrieval details and Ollama timings
DEBUG=false

# ── frontend (app.py run outside Docker) ─────────────────────────────────
BACKEND_URL=http://localhost:8000
