# Environment variables for local development
# Copy this file to .env and fill in your values
# Do NOT commit .env to version control
#
# config.py loads .env when the app runs on the Mac, and docker-compose passes
# it into the backend container with env_file. A variable already set in the
# shell wins over .env when running locally. Leaving a line out (or blank)
# uses the default shown here.

# Ollama server. Inside compose this is replaced by http://ollama:11434
OLLAMA_URL=http://localhost:11434

# model /ask sends prompts to, has to be pulled first (ollama pull <name>)
MODEL_NAME=llama3.2:1b

# ChromaDB folder, relative paths are from the app folder.
# Inside compose this is replaced by /app/rag_db (the chroma_data volume)
CHROMA_PATH=./rag_db

# default n_results for /ask, whole number from 1 to 20
MAX_RESULTS=3

# default max_distance for /ask, chunks further away than this are dropped.
# Squared L2 distance from 0 to 4, lower is stricter
CONFIDENCE_THRESHOLD=1.0

# true/false (1/0, yes/no, on/off also work). Logs retrieval details and
# Ollama timings, and returns tracebacks on unhandled errors
DEBUG=false
