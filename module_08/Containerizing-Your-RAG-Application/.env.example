# Environment defaults for the stack. Copy to .env and change what you need.
# .env is ignored by git and by both images. Leaving a line out (or blank)
# uses the default shown here.

# ── backend (read by backend/config.py) ──────────────────────────────────

# Ollama server. Inside compose this is replaced by http://ollama:11434
OLLAMA_URL=http://localhost:11434

# model /ask sends prompts to, has to be pulled first:
#   docker-compose exec ollama ollama pull llama3.2:1b
MODEL_NAME=llama3.2:1b

# ChromaDB folder, relative to backend/. Inside compose this is replaced by
# /app/rag_db, where the chroma_data volume is mounted
CHROMA_PATH=./rag_db

# default n_results for /ask, whole number from 1 to 20
MAX_RESULTS=3

# default max_distance for /ask, chunks further away than this are dropped.
# Squared L2 distance from 0 to 4, lower is stricter
CONFIDENCE_THRESHOLD=1.0

# true/false. Logs retrieval details and Ollama timings, and returns
# tracebacks on unhandled errors
DEBUG=false

# ── compose ──────────────────────────────────────────────────────────────

# host port for the ollama container. Use 11435 if Ollama is already
# running on the Mac and holding 11434
OLLAMA_HOST_PORT=11434

# ── frontend (only when running app.py outside Docker) ───────────────────

# compose sets http://backend:8000 for the container
BACKEND_URL=http://localhost:8000
